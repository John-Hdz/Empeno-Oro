# Configuración de la aplicación
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/Empenio
BASE_PATH=/Empenio

# Base de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=presta_prenda
DB_USER=tu_usuario_bd
DB_PASSWORD=tu_contrasena_bd

# Carpeta de archivos subidos (ruta relativa a la raíz del proyecto o ruta absoluta)
UPLOAD_DIR=uploads

# Configuración de correo SMTP (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=smtps
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_FROM_NAME="Presta Prenda"
